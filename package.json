{
  "name": "afterglowsdev-gateway",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @afterglowsdev/gateway dev",
    "dev:admin": "pnpm --filter @afterglowsdev/admin dev",
    "dev:all": "pnpm run --parallel --filter @afterglowsdev/gateway --filter @afterglowsdev/admin dev",
    "build": "pnpm --filter @afterglowsdev/admin build && pnpm --filter @afterglowsdev/gateway build",
    "start": "pnpm --filter @afterglowsdev/gateway start",
    "typecheck": "pnpm --filter @afterglowsdev/gateway typecheck"
  }
}
