# LLM API Gateway — Environment Variables / 环境变量
# Copy to .env and fill in your values / 复制为 .env 并填写实际值

# ---- Required / 必填 ----
NEW_API_BASE_URL=https://your-newapi.example.com
NEW_API_TOKEN=your-newapi-token

# ---- Admin / 管理员 ----
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-secret

# ---- Store backends / 存储后端 ----
# Config store: "file" | "memory" | "env" | "redis"
CONFIG_STORE_TYPE=file
CONFIG_FILE_PATH=./data/gateway-config.json

# Usage store: "memory" | "file" | "redis"
USAGE_STORE_TYPE=memory
# USAGE_FILE_PATH=./data/gateway-usage.json

# Rate limit store: "memory" | "redis"
RATE_LIMIT_STORE_TYPE=memory

# Device store: "memory" | "file"
DEVICE_STORE_TYPE=memory
# DEVICE_FILE_PATH=./data/gateway-devices.json

# Redis (optional, for serverless multi-instance deployments)
# REDIS_URL=redis://localhost:6379

# ---- Gateway settings / 网关设置 ----
# Gateway config via env var (used when CONFIG_STORE_TYPE=env, read-only)
# GATEWAY_CONFIG_JSON={"defaultProfile":"app-fast","debug":false,"timeoutMs":30000,"requestBodyLimitBytes":1048576,"profiles":{},"apps":[]}

# ---- Logging / 日志 ----
LOG_LEVEL=info
NODE_ENV=development

# ---- Server / 服务器 ----
PORT=3000
