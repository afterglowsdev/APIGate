# LLM API Gateway — Environment Variables
# Copy this to .env and fill in your values

# Required: New API upstream
NEW_API_BASE_URL=https://your-newapi.example.com
NEW_API_TOKEN=your-newapi-token

# Required: Admin password for the management GUI
ADMIN_PASSWORD=change-me

# Optional: JWT secret for admin sessions (auto-generated if not set)
# ADMIN_JWT_SECRET=change-me-secret

# Optional: Encryption key for sensitive stored data
# ENCRYPTION_KEY=

# Store type: "memory" | "file" | "env" | "redis" | "cloudflare-kv"
CONFIG_STORE_TYPE=file
CONFIG_FILE_PATH=./data/gateway-config.json

USAGE_STORE_TYPE=memory
# USAGE_FILE_PATH=./data/gateway-usage.json

RATE_LIMIT_STORE_TYPE=memory
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Gateway settings (can also be set in admin GUI)
# GATEWAY_CONFIG_JSON={"defaultProfile":"app-fast","debug":false,"timeoutMs":30000,"requestBodyLimitBytes":1048576,"profiles":{},"clients":[]}
